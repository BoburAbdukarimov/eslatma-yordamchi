{
  "name": "vazifalar-monitori",
  "private": true,
  "version": "0.0.0",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
   "appId": "com.vazifalar.yordamchi",
